        {
            "title": "Error Rates",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 12
            },
            "targets": [
                {
                    "expr": "rate(scalerunner_poll_errors_total[5m])",
                    "legendFormat": "Poll Errors/s"
                },
                {
                    "expr": "rate(scalerunner_launch_errors_total[5m])",
                    "legendFormat": "Launch Errors/s"
                },
                {
                    "expr": "rate(scalerunner_token_errors_total[5m])",
                    "legendFormat": "Token Errors/s"
