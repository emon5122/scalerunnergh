            "type": "stat",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 18,
                "y": 0
            },
            "targets": [
                {
                    "expr": "scalerunner_total_launched",
                    "legendFormat": "Launched"
                },
                {
                    "expr": "scalerunner_total_completed",
                    "legendFormat": "Completed"
                },
                {
                    "expr": "scalerunner_total_failed",
                    "legendFormat": "Failed"
                }
            ]
        },
        {
