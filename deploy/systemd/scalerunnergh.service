# Native mode on a Linux host (no Docker needed): a runner process per job.
# Run as a dedicated non-root user; the GitHub runner refuses to run as root.
[Unit]
Description=ScaleRunnerGH (ephemeral GitHub Actions runners)
After=network-online.target
Wants=network-online.target

[Service]
User=srg
Group=srg
ExecStart=/usr/local/bin/scalerunnergh --config /etc/scalerunnergh/config.json
# The restart record lives outside the config, so even a config that fails to load counts toward a restart
# spike. Optionally name an alert program (run with SRG_ALERT, SRG_HOST, SRG_STARTS, SRG_WINDOW, SRG_LAST_ERROR).
StateDirectory=scalerunnergh
Environment=SCALERUNNERGH_STATE_DIR=/var/lib/scalerunnergh
#Environment=SCALERUNNERGH_ALERT_COMMAND=/usr/local/bin/scalerunnergh-alert
Restart=always
RestartSec=10
# Longer than host.drain_timeout, so a restart lets running jobs finish.
TimeoutStopSec=2100
KillMode=mixed
Nice=5

[Install]
WantedBy=multi-user.target
