{
  "host": {
    "name": "docker-host",
    "max_runners": 3,
    "max_heavy": 1,
    "kill_switch_file": "/control/STOP",
    "drain_timeout": "45m"
  },
  "auth": { "pat_file": "/run/secrets/github_pat" },
  "docker": { "registry_mirror": "" },
  "scale_sets": [
    {
      "name": "srg-docker",
      "url": "https://github.com/my-org",
      "runner_group": "ci-private",
      "labels": ["Linux", "docker"],
      "backend": "docker",
      "image": "ghcr.io/emon5122/scalerunnergh-runner:media-1.0.0",
      "dind": true,
      "heavy": false,
      "limits": { "cpus": 2, "memory_mb": 4096, "pids": 4096 }
    }
  ],
  "metrics": { "enabled": true, "address": ":9090" },
  "log_level": "info"
}
